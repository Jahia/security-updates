    "test": "jest --coverage ./src/javascript",
    "tdd": "jest --watch ./src/javascript",
    "lint": "eslint --ext js,jsx src",
    "lint:fix": "yarn lint --fix",
    "sync-pom": "sync-pom-version --use-yarn"
  },
  "description": "Lists the installed Jahia components that have security updates, from the Jahia Store security feed",
